FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3;

deltaT          0.01;

writeControl    adjustable;

writeInterval   0.2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.5;

maxDeltaT       1;


functions
{
    buildingForces
    {
        type            forces;
        libs            ("libforces.so");

        patches         (building);

        p               p_rgh;
        U               U;

        rho             rhoInf;
        rhoInf          1000;

        pRef            0;

        CofR            (0 0 0);

        writeControl    timeStep;
        writeInterval   1;
    }
}

