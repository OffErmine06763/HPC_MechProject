FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    building_separated.stl
    {
        type triSurfaceMesh;
        name building;
        regions
        {
            front
            {
                name building_front;
            }
            back
            {
                name building_back;
            }
            left
            {
                name building_left;
            }
            right
            {
                name building_right;
            }
            bottom
            {
                name building_bottom;
            }
            top
            {
                name building_top;
            }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      2000000;
    minRefinementCells  0;
    nCellsBetweenLevels 3;

    features ();

    refinementSurfaces
    {
        building
        {
            level (0 0);

            regions
            {
                front
                {
                    level (0 0);
                    patchInfo
                    {
                        type wall;
                        inGroups (building);
                    }
                }

                "(back|left|right|bottom|top)"
                {
                    level (0 0);
                    patchInfo
                    {
                        type wall;
                        inGroups (building);
                    }
                }
            }
        }
    }

    refinementRegions
    {
    }

    resolveFeatureAngle 30;

    locationInMesh (1 1 0.5);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance    2.0;
    nSolveIter   30;
    nRelaxIter   5;
}

addLayersControls
{
    relativeSizes true;
    layers {};
}

meshQualityControls
{
    #include "meshQualityDict"
}

mergeTolerance 1e-6;