FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    building.stl
    {
        type triSurfaceMesh;
        name building;
    }
}

castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      2000000;
    minRefinementCells  0;
    nCellsBetweenLevels 3;

    features ();

    refinementSurfaces
    {
        building
        {
            level (0 0);

            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
    }

    resolveFeatureAngle 30;

    locationInMesh (1 1 0.5);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance    2.0;
    nSolveIter   30;
    nRelaxIter   5;
}

addLayersControls
{
    relativeSizes true;
    layers {};
}

meshQualityControls
{
    #include "meshQualityDict"
}

mergeTolerance 1e-6;